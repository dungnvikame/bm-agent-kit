{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bm-agent-kit/payload-preview-record",
  "title": "Task Payload Preview Record (output of create-asana-tasks skill in proposal-only mode, spec 5.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "artifact_id", "artifact_version", "output_type", "status", "requires_human_review",
    "human_owner", "reviewer", "breakdown_artifact_id", "sources", "target", "preconditions", "write_adapter",
    "handoff_mode", "items", "facts", "inferences", "proposals", "open_questions", "gate_status", "external_action", "approval"
  ],
  "properties": {
    "schema_version": { "const": "bm-agent-contract/0.2" },
    "run_id": { "type": "string", "minLength": 1 },
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_version": { "type": "string", "pattern": "-draft$" },
    "output_type": { "const": "payload_preview_record" },
    "status": { "const": "draft" },
    "requires_human_review": { "const": true },
    "human_owner": { "type": "string" }, "reviewer": { "type": "string" },
    "kit_version": { "type": "string" }, "runtime": { "type": "string" }, "created_at": { "type": "string" },
    "breakdown_artifact_id": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["source_id", "location", "retrieved_at"],
        "properties": { "source_id": { "type": "string" }, "location": { "type": "string" }, "retrieved_at": { "type": "string" }, "version_or_snapshot": { "type": "string" } } }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["project_id", "parent_task_id", "verified"],
      "properties": {
        "project_id": { "type": ["string", "null"] }, "parent_task_id": { "type": ["string", "null"] },
        "verified": { "type": "boolean", "description": "true only when project/parent were read from the task source in this run" },
        "note": { "type": "string" }
      }
    },
    "preconditions": {
      "type": "object", "additionalProperties": false, "required": ["dev_g3", "action_approval"],
      "properties": {
        "dev_g3": { "type": "object", "additionalProperties": false, "required": ["status", "approval_ref"],
          "properties": { "status": { "type": "string", "enum": ["approved", "missing", "invalid"] }, "approval_ref": { "type": ["string", "null"] }, "reason": { "type": "string" } } },
        "action_approval": { "type": "object", "additionalProperties": false, "required": ["status", "approval_ref", "payload_hash_expected"],
          "properties": { "status": { "type": "string", "enum": ["present", "missing", "invalid", "stale"] }, "approval_ref": { "type": ["string", "null"] },
            "payload_hash_expected": { "type": ["string", "null"] }, "operation": { "type": ["string", "null"] }, "reason": { "type": "string" } } }
      }
    },
    "write_adapter": { "const": "disabled" },
    "handoff_mode": { "const": "manual_entry_by_human" },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_id", "proposal_id", "operation", "target_task_id", "payload", "payload_hash", "diff", "side_effects", "duplicate_candidates", "block_reasons"],
        "properties": {
          "item_id": { "type": "string" }, "proposal_id": { "type": "string" },
          "operation": { "type": "string", "enum": ["create", "update", "link", "no_op", "blocked"] },
          "target_task_id": { "type": ["string", "null"] },
          "payload": {
            "type": "object", "additionalProperties": false, "required": ["name", "notes", "project_id", "parent_task_id"],
            "properties": { "name": { "type": "string", "minLength": 1 }, "notes": { "type": "string" }, "project_id": { "type": ["string", "null"] }, "parent_task_id": { "type": ["string", "null"] } }
          },
          "payload_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "diff": { "type": "array", "items": { "type": "string" } },
          "side_effects": { "type": "array", "items": { "type": "string" } },
          "duplicate_candidates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["task_id", "title", "score"],
            "properties": { "task_id": { "type": "string" }, "title": { "type": "string" }, "score": { "type": "number" }, "status": { "type": "string" } } } },
          "block_reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "facts": { "type": "array", "items": { "$ref": "evidence-item.schema.json" } },
    "inferences": { "type": "array", "items": { "$ref": "evidence-item.schema.json" } },
    "proposals": { "type": "array", "items": { "$ref": "evidence-item.schema.json" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "gate_status": { "type": "object", "additionalProperties": { "type": "string", "enum": ["not_started", "pending", "approved", "invalidated"] } },
    "external_action": { "type": "object", "additionalProperties": false, "required": ["requested", "executed"],
      "properties": { "requested": { "const": false }, "executed": { "const": false } } },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_type", "approved_by", "approved_at", "decision", "permits_external_write", "permits_send"],
      "properties": {
        "approval_type": { "const": "artifact_only" }, "gate": { "type": "string" },
        "approved_by": { "type": ["string", "null"] }, "approved_at": { "type": ["string", "null"] },
        "decision": { "type": "string", "enum": ["pending", "approved", "rejected", "changes_requested"] },
        "permits_external_write": { "const": false }, "permits_send": { "const": false }
      }
    }
  }
}
