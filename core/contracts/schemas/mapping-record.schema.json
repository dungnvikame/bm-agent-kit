{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bm-agent-kit/mapping-record",
  "title": "Requirement/Task Mapping Record (output of map-requirements skill, spec 5.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "artifact_id",
    "artifact_version",
    "output_type",
    "status",
    "requires_human_review",
    "human_owner",
    "reviewer",
    "intake_artifact_id",
    "sources",
    "search_scope",
    "mappings",
    "facts",
    "inferences",
    "proposals",
    "open_questions",
    "gate_status",
    "external_action",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "bm-agent-contract/0.2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_version": {
      "type": "string",
      "pattern": "-draft$"
    },
    "output_type": {
      "const": "mapping_record"
    },
    "status": {
      "const": "draft"
    },
    "requires_human_review": {
      "const": true
    },
    "human_owner": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "kit_version": {
      "type": "string"
    },
    "runtime": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "intake_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "location",
          "retrieved_at"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "retrieved_at": {
            "type": "string"
          },
          "version_or_snapshot": {
            "type": "string"
          }
        }
      }
    },
    "search_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "requirements_snapshot",
        "tasks_snapshot",
        "requirements_scanned",
        "tasks_scanned",
        "exhaustive"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "requirements_snapshot": {
          "type": "string"
        },
        "tasks_snapshot": {
          "type": "string"
        },
        "requirements_scanned": {
          "type": "integer"
        },
        "tasks_scanned": {
          "type": "integer"
        },
        "exhaustive": {
          "type": "boolean"
        },
        "synonyms_used": {
          "type": "boolean"
        },
        "module_filter": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part_id",
          "feedback_part_summary",
          "requirement_candidates",
          "requirement_id",
          "match_type",
          "match_basis",
          "existing_tasks",
          "missing_decision",
          "conflict",
          "proposed_action",
          "blockers"
        ],
        "properties": {
          "part_id": {
            "type": "string"
          },
          "feedback_part_summary": {
            "type": "string"
          },
          "requirement_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requirement_id",
                "title",
                "score",
                "matched_terms",
                "approval_status",
                "domain"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "matched_terms": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "approval_status": {
                  "type": "string",
                  "enum": [
                    "approved",
                    "not_approved",
                    "unknown"
                  ]
                },
                "domain": {
                  "type": "string"
                },
                "decision_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "module": {
                  "type": "string"
                },
                "decision_status": {
                  "type": "string",
                  "enum": [
                    "live",
                    "superseded",
                    "inactive",
                    "unknown_ref",
                    "none"
                  ]
                }
              }
            }
          },
          "requirement_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "match_type": {
            "type": "string",
            "enum": [
              "exact",
              "partial",
              "gap",
              "conflict",
              "unknown"
            ]
          },
          "match_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "existing_tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "title",
                "status",
                "release_evidence"
              ],
              "properties": {
                "task_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "open",
                    "check",
                    "done",
                    "unknown"
                  ]
                },
                "section": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "modified_at": {
                  "type": "string"
                },
                "release_evidence": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "QA or release evidence location; null = none seen"
                }
              }
            }
          },
          "missing_decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "conflict": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "domain",
              "decision_ids",
              "blocked_decisions"
            ],
            "properties": {
              "domain": {
                "type": "string"
              },
              "decision_ids": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "blocked_decisions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "proposed_action": {
            "type": "string",
            "enum": [
              "review_existing",
              "link_existing",
              "request_qa_evidence",
              "hold_for_shape",
              "propose_new_scope",
              "ask_owner",
              "no_op",
              "unknown"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "evidence-item.schema.json"
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "$ref": "evidence-item.schema.json"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "evidence-item.schema.json"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_status": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "not_started",
          "pending",
          "approved",
          "invalidated"
        ]
      }
    },
    "external_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "executed"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "executed": {
          "type": "boolean"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_type",
        "approved_by",
        "approved_at",
        "decision",
        "permits_external_write",
        "permits_send"
      ],
      "properties": {
        "approval_type": {
          "const": "artifact_only"
        },
        "gate": {
          "type": "string"
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "changes_requested"
          ]
        },
        "permits_external_write": {
          "const": false
        },
        "permits_send": {
          "const": false
        }
      }
    }
  }
}
