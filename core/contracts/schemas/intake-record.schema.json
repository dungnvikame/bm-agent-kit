{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bm-agent-kit/intake-record",
  "title": "Intake Record (output of intake-feedback skill)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "artifact_id", "artifact_version", "output_type", "status",
    "requires_human_review", "human_owner", "reviewer", "sources", "feedback", "parts",
    "sensitive_content", "untrusted_instructions", "facts", "inferences", "proposals",
    "open_questions", "requirement_task_mapping", "gate_status", "external_action", "approval"
  ],
  "properties": {
    "schema_version": { "const": "bm-agent-contract/0.2" },
    "run_id": { "type": "string", "minLength": 1 },
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_version": { "type": "string", "pattern": "-draft$" },
    "output_type": { "const": "intake_record" },
    "status": { "const": "draft" },
    "requires_human_review": { "const": true },
    "human_owner": { "type": "string" },
    "reviewer": { "type": "string" },
    "kit_version": { "type": "string" },
    "runtime": { "type": "string" },
    "created_at": { "type": "string" },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "location", "retrieved_at"],
        "properties": {
          "source_id": { "type": "string" }, "location": { "type": "string" },
          "retrieved_at": { "type": "string" }, "version_or_snapshot": { "type": "string" }
        }
      }
    },
    "feedback": {
      "type": "object", "additionalProperties": false,
      "required": ["feedback_id", "submitted_at", "module", "product", "channel", "reporter_role"],
      "properties": {
        "feedback_id": { "type": "string" }, "submitted_at": { "type": "string" },
        "module": { "type": "string" }, "product": { "type": "string" },
        "channel": { "type": "string" }, "reporter_role": { "type": "string" },
        "source_priority_label": { "type": "string" },
        "source_status_label": { "type": "string" }
      }
    },
    "parts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["part_id", "text_redacted", "need", "symptom", "expected", "actual", "affected_users",
                     "environment", "reproducible", "category_proposed", "severity_proposed", "duplicate_candidates"],
        "properties": {
          "part_id": { "type": "string" },
          "text_redacted": { "type": "string" },
          "need": { "type": ["string", "null"] },
          "symptom": { "type": ["string", "null"] },
          "proposed_solution_by_reporter": { "type": ["string", "null"] },
          "expected": { "type": ["string", "null"] },
          "actual": { "type": ["string", "null"] },
          "affected_users": { "type": "string" },
          "environment": { "type": "string" },
          "reproducible": { "type": "string", "enum": ["yes", "no", "unknown"] },
          "category_proposed": { "type": "string", "enum": ["bug", "usability", "feature", "question", "data", "permission", "possible_incident", "unknown"] },
          "severity_proposed": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
          "severity_basis": { "type": ["string", "null"] },
          "duplicate_candidates": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["task_id", "title", "score", "matched_terms", "status"],
              "properties": {
                "task_id": { "type": "string" }, "title": { "type": "string" },
                "score": { "type": "number" }, "matched_terms": { "type": "array", "items": { "type": "string" } },
                "status": { "type": "string" }, "section": { "type": "string" }, "modified_at": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "sensitive_content": {
      "type": "object", "additionalProperties": false,
      "required": ["detected", "categories", "redacted_note"],
      "properties": {
        "detected": { "type": "boolean" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "redacted_note": { "type": ["string", "null"] }
      }
    },
    "untrusted_instructions": {
      "type": "object", "additionalProperties": false,
      "required": ["detected", "warnings"],
      "properties": {
        "detected": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["pattern_id", "part_id"],
            "properties": { "pattern_id": { "type": "string" }, "part_id": { "type": "string" }, "position": { "type": "integer" } }
          }
        }
      }
    },
    "facts": { "type": "array", "items": { "$ref": "evidence-item.schema.json" } },
    "inferences": { "type": "array", "items": { "$ref": "evidence-item.schema.json" } },
    "proposals": { "type": "array", "items": { "$ref": "evidence-item.schema.json" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "requirement_task_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "duplicate_search"],
      "properties": {
        "status": { "type": "string", "enum": ["pending_map_requirements", "done"] },
        "duplicate_search": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "snapshot", "tasks_scanned", "exhaustive"],
          "properties": {
            "method": { "type": "string" }, "snapshot": { "type": "string" },
            "tasks_scanned": { "type": "integer" }, "exhaustive": { "type": "boolean" },
            "synonyms_used": { "type": "boolean" }, "note": { "type": "string" }
          }
        }
      }
    },
    "gate_status": {
      "type": "object",
      "additionalProperties": { "type": "string", "enum": ["not_started", "pending", "approved", "invalidated"] }
    },
    "external_action": {
      "type": "object", "additionalProperties": false,
      "required": ["requested", "executed"],
      "properties": { "requested": { "type": "boolean" }, "executed": { "type": "boolean" } }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_type", "approved_by", "approved_at", "decision", "permits_external_write", "permits_send"],
      "properties": {
        "approval_type": { "const": "artifact_only" },
        "gate": { "type": "string" },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] },
        "decision": { "type": "string", "enum": ["pending", "approved", "rejected", "changes_requested"] },
        "permits_external_write": { "const": false },
        "permits_send": { "const": false }
      }
    }
  }
}
